# Long random secret that only YOUR Windows app knows. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HOME_SECRET=replace_me_with_a_long_random_hex_string

# Port the server listens on (most hosts set this for you)
PORT=8080

# How long a printed message's CONTENT survives before being scrubbed (hours).
# Only the id + status survive after this, for duplicate-delivery protection.
CONTENT_RETENTION_HOURS=24

# How long an unclaimed pairing code stays valid (minutes)
PAIRING_CODE_TTL_MINUTES=10
